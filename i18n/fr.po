msgstr "Vous n'êtes pas autorisé à accéder à cette réservation."

#. module: location_auto
#: code:addons/location_auto/controllers/portal.py:0
#, python-format
msgid "The reservation was cancelled by the customer."
msgstr "La réservation a été annulée par le client."

