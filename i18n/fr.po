#. module: location_auto
#: code:addons/location_auto/models/reservation.py:0
#, python-format
msgid "The end date must be after or equal to the start date."
msgstr "La date de fin doit être postérieure ou égale à la date de début."

#. module: location_auto
#: code:addons/location_auto/models/reservation.py:0
#, python-format
msgid "This vehicle is already booked from %s to %s for this period."
msgstr "Ce véhicule est déjà réservé du %s au %s pour cette période."

#. module: location_auto
#: code:addons/location_auto/models/reservation.py:0
#, python-format
msgid "This reservation was automatically cancelled: the vehicle %s has been booked by another customer from %s to %s."
msgstr "Cette réservation a été annulée automatiquement : le véhicule %s a été réservé par un autre client du %s au %s."

#. module: location_auto
#: code:addons/location_auto/models/reservation.py:0
#, python-format
msgid "Your reservation %s has been cancelled"
msgstr "Votre réservation %s a été annulée"

#. module: location_auto
#: code:addons/location_auto/models/reservation.py:0
#, python-format
msgid "Hello %s,<br/>Your reservation <b>%s</b> has been automatically cancelled because the vehicle <b>%s</b> has been booked by another customer for the same period (from %s to %s)."
msgstr "Bonjour %s,<br/>Votre réservation <b>%s</b> a été annulée automatiquement car le véhicule <b>%s</b> a été réservé par un autre client pour la même période (du %s au %s)."

#. module: location_auto
#: code:addons/location_auto/controllers/portal.py:0
#, python-format
msgid "Please select a vehicle and your rental dates."
msgstr "Veuillez sélectionner un véhicule et vos dates de location."

#. module: location_auto
#: code:addons/location_auto/controllers/portal.py:0
#, python-format
msgid "The end date must be after or equal to the start date."
msgstr "La date de fin doit être postérieure ou égale à la date de début."

#. module: location_auto
#: code:addons/location_auto/controllers/portal.py:0
#, python-format
msgid "This vehicle is already booked from %s to %s for this period."
msgstr "Ce véhicule est déjà réservé du %s au %s pour cette période."

#. module: location_auto
#: code:addons/location_auto/controllers/portal.py:0
#, python-format
