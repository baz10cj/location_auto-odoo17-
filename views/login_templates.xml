<odoo>
    <template id="login_layout_override" name="Keydrive Login Layout" inherit_id="website.login_layout" priority="30">
        <xpath expr="t" position="replace">
            <t t-call="website.layout">
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                <div class="la-login-shell">
                    <div class="la-login-bg"></div>
                    <div class="la-login-top">
                        <t t-call="location_auto.la_header"/>
                    </div>
                    <div class="la-login-stage">
                        <div class="la-login-card">
                            <a href="/location-auto" class="la-login-brand">
                                <img src="/location_auto/static/img/LOGO.png" alt="Keydrive" class="la-login-brand-img"/>
                            </a>
                            <p class="la-eyebrow">Espace client</p>
                            <h2 class="la-login-title">Bon retour parmi nous.</h2>
                            <div class="oe_website_login_container" t-out="0"/>
                            <div class="la-login-alt">
                                <span>Pas encore de compte ?</span>
                                <a href="/my/register" class="la-login-link">Créer mon compte</a>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <template id="login_form_override" name="Keydrive Login Form" inherit_id="web.login">
        <xpath expr="//form[hasclass('oe_login_form')]" position="replace">
            <form class="la-login-form" role="form" t-attf-action="/web/login" method="post" onsubmit="this.action = '/web/login' + location.hash">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="la-field-group">
                    <label for="login">Email</label>
                    <input type="text" name="login" id="login" t-att-value="login" placeholder="vous@exemple.com" required="required" autocomplete="username" autofocus="autofocus" autocapitalize="off"/>
                </div>
                <div class="la-field-group">
                    <label for="password">Mot de passe</label>
                    <input type="password" name="password" id="password" placeholder="••••••••" required="required" autocomplete="current-password" maxlength="4096"/>
                </div>
                <p class="la-login-alert" t-if="error" role="alert">
                    <t t-esc="error"/>
                </p>
                <p class="la-login-alert la-login-alert-success" t-if="message" role="status">
                    <t t-esc="message"/>
                </p>
                <button type="submit" class="la-btn la-btn-primary la-login-submit">Se connecter</button>
                <input type="hidden" name="redirect" t-att-value="redirect"/>
            </form>
        </xpath>
    </template>
</odoo>
