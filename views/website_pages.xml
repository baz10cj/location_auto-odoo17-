<odoo>
    <record id="location_auto_home_page" model="website.page">
        <field name="name">Location Auto Homepage</field>
        <field name="url">/location-auto</field>
        <field name="view_id" ref="location_auto.website_location_auto_homepage"/>
        <field name="is_published">True</field>
        <field name="website_indexed">True</field>
    </record>

    <record id="location_auto_home_menu" model="website.menu">
        <field name="name">Keydrive</field>
        <field name="url">/location-auto</field>
        <field name="page_id" ref="location_auto.location_auto_home_page"/>
        <field name="sequence">1</field>
    </record>
</odoo>
