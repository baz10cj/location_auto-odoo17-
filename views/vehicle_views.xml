<odoo>
    <record id="view_location_vehicle_tree" model="ir.ui.view">
        <field name="name">location.vehicle.tree</field>
        <field name="model">location.vehicle</field>
        <field name="arch" type="xml">
            <tree string="Véhicules">
                <field name="name"/>
                <field name="license_plate"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_location_vehicle_form" model="ir.ui.view">
        <field name="name">location.vehicle.form</field>
        <field name="model">location.vehicle</field>
        <field name="arch" type="xml">
            <form string="Véhicule">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_inspections" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="inspection_count" widget="statinfo" string="Inspections"/>
                        </button>
                        <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="documents_count" widget="statinfo" string="Documents client"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_1920'}"/>
                            <field name="name"/>
                            <field name="brand"/>
                            <field name="model"/>
                            <field name="license_plate"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="daily_rate"/>
                            <field name="seats"/>
                            <field name="gearbox"/>
                            <field name="fuel_type"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_location_vehicle" model="ir.actions.act_window">
        <field name="name">Véhicules</field>
        <field name="res_model">location.vehicle</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
