<odoo>
    <record id="group_location_user" model="res.groups">
        <field name="name">Rental User</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <record id="group_location_manager" model="res.groups">
        <field name="name">Rental Manager</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <record id="group_location_portal_customer" model="res.groups">
        <field name="name">Portal Customer</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <record id="base.group_portal" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_location_portal_customer'))]"/>
    </record>

    <record id="group_support_agent" model="res.groups">
        <field name="name">Support Agent</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_reservation_portal" model="ir.rule">
        <field name="name">Portal customer reservations</field>
        <field name="model_id" ref="model_location_reservation"/>
        <field name="groups" eval="[(4, ref('group_location_portal_customer'))]"/>
        <field name="domain_force">[('customer_id', '=', user.partner_id.id)]</field>
    </record>

    <record id="rule_contract_portal" model="ir.rule">
        <field name="name">Portal customer contracts</field>
        <field name="model_id" ref="model_location_contract"/>
        <field name="groups" eval="[(4, ref('group_location_portal_customer'))]"/>
        <field name="domain_force">[('customer_id', '=', user.partner_id.id)]</field>
    </record>

    <record id="rule_inspection_portal" model="ir.rule">
        <field name="name">Portal customer inspections</field>
        <field name="model_id" ref="model_location_etat_lieux"/>
        <field name="groups" eval="[(4, ref('group_location_portal_customer'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
    </record>

    <record id="rule_document_portal" model="ir.rule">
        <field name="name">Portal customer documents</field>
        <field name="model_id" ref="model_location_client_document"/>
        <field name="groups" eval="[(4, ref('group_location_portal_customer'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
    </record>

    <record id="rule_invoice_portal" model="ir.rule">
        <field name="name">Portal customer invoices</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="groups" eval="[(4, ref('group_location_portal_customer'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
    </record>

    <record id="rule_support_ticket_portal" model="ir.rule">
        <field name="name">Portal customer support tickets</field>
        <field name="model_id" ref="model_la_support_ticket"/>
        <field name="groups" eval="[(4, ref('group_location_portal_customer'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
    </record>

    <record id="rule_support_message_portal" model="ir.rule">
        <field name="name">Portal customer support messages</field>
        <field name="model_id" ref="model_la_support_message"/>
        <field name="groups" eval="[(4, ref('group_location_portal_customer'))]"/>
        <field name="domain_force">[('ticket_id.partner_id', '=', user.partner_id.id)]</field>
    </record>
</odoo>
